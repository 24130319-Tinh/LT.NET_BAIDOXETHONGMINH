## Ignore Visual Studio, Rider & .NET temporary files, build results, and IDE folders

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio, JetBrains Rider & VS Code cache/options directory
.vs/
.idea/
.vscode/
*.sln.iml

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# SQLite temporary runtime files (WAL / SHM / Journal)
*.db-shm
*.db-wal
*.db-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# (Tuỳ chọn) Bỏ dấu # ở 2 dòng dưới nếu nhóm tự tạo DB bằng code/script .sql và không muốn bị xung đột file .db khi test:
# *.db
# *.sqlite

# Local environment / secret config
.env
*.local.json

# OS generated files
.DS_Store
Thumbs.db
