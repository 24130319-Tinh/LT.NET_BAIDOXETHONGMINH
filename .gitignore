## Ignore Visual Studio, Rider & .NET temporary files, build results, and IDE folders

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio, JetBrains Rider & VS Code cache/options directory
.vs/
.idea/
.vscode/
*.sln.iml

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# SQLite temporary runtime files (WAL / SHM / Journal)
*.db-shm
*.db-wal
*.db-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# Local SQLite database (runtime data — không commit)
*.db
*.sqlite
BAIDOXETHONGMINH/DAL/Database/smart_parking.db

# Local environment / secret config
.env
*.local.json

# Command Code local tool data
.commandcode/

# Ảnh xe lưu tạm trong quá trình chạy thử Check-in / Check-out
**/Assets/SessionImages/*
!**/Assets/SessionImages/.gitkeep

# OS generated files
.DS_Store
Thumbs.db
$null